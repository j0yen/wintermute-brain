# brain-local.env.example — template for /etc/wintermute/brain-local.env
# (or ~/.config/wintermute/brain-local.env for user-level override).
#
# Copy to brain-local.env, fill in secrets, chmod 600.
# PRD-constellation-brain-local AC7: endpoint + api-key come from this file,
# never hardcoded in the service unit.

# Absolute path to the model file (qwen2.5-8B-Instruct Q4_K_M, ~5.4 GB).
# Download with: huggingface-cli download bartowski/Qwen2.5-7B-Instruct-GGUF
#   --include "Qwen2.5-7B-Instruct-Q4_K_M.gguf" --local-dir /srv/llm/models/
LLAMA_MODEL_PATH=/srv/llm/models/qwen2.5-8b-instruct-Q4_K_M.gguf

# API key for the llama-server endpoint. Also set WM_BRAIN_LOCAL_LLM_API_KEY
# in the brain daemon's env so it injects Authorization: Bearer <key>.
# Generate with: openssl rand -hex 32
LLAMA_API_KEY=changeme

# Extra llama.cpp flags selected by detect-backend.sh.
# Vulkan (if detect-backend chose it): --n-gpu-layers 9999
# CPU (default / fallback):             (empty)
LLAMA_EXTRA_FLAGS=

# Optional: path to the secondary 3B model for faster routing/secondary turns.
# Uncomment and set to serve a 3B model alongside the 8B.
# LLAMA_3B_MODEL_PATH=/srv/llm/models/qwen2.5-3b-instruct-Q4_K_M.gguf
